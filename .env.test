APP_NAME="Intelligent AI Camera Hub (Testing)"
APP_ENV=testing
APP_KEY=base64:2uDSBwXABxqKrme22nL1rR4Acnranb/7QN9hBStcbM8=
APP_DEBUG=true
APP_TIMEZONE=Asia/Manila
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=4

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Database (PostgreSQL 16 - Test Database)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=camera_hub_test
DB_USERNAME=postgres
DB_PASSWORD=secret

# Session & Cache
SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Queue & Broadcasting
BROADCAST_CONNECTION=null
CACHE_STORE=array
CACHE_PREFIX=
QUEUE_CONNECTION=sync

# Redis Configuration
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# MQTT Broker (Testing)
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_TIMEOUT=10
MQTT_KEEP_ALIVE=60
MQTT_AUTH=false
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_BASE_TOPIC=mqtt/face_test

# Laravel Reverb (WebSockets)
REVERB_APP_ID=camera_hub_app
REVERB_APP_KEY=camera_hub_key
REVERB_APP_SECRET=camera_hub_secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

# Storage
FILESYSTEM_DISK=public
