APP_NAME="Intelligent Vision Edge & Telemetry Hub"
APP_ENV=local
APP_KEY=base64:2uDSBwXABxqKrme22nL1rR4Acnranb/7QN9hBStcbM8=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database (PostgreSQL 16)
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=camera_hub
DB_USERNAME=postgres
DB_PASSWORD=secret

# Session & Cache
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Queue & Horizon
BROADCAST_CONNECTION=reverb
CACHE_STORE=redis
CACHE_PREFIX=
QUEUE_CONNECTION=redis

# Redis Configuration
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# MQTT Broker (EMQX / Mosquitto)
MQTT_HOST=mqtt
MQTT_PORT=1883
MQTT_TIMEOUT=10
MQTT_KEEP_ALIVE=60
MQTT_AUTH=false
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_BASE_TOPIC=mqtt/face

# Laravel Reverb (WebSockets)
REVERB_APP_ID=camera_hub_app
REVERB_APP_KEY=camera_hub_key
REVERB_APP_SECRET=camera_hub_secret
REVERB_HOST=0.0.0.0
REVERB_PORT=8080
REVERB_SCHEME=http
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="localhost"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Storage (Local / S3 / R2)
FILESYSTEM_DISK=public

# Docker Compose Exposed Host Ports
APP_PORT=8000
FORWARD_DB_PORT=5432
FORWARD_REDIS_PORT=6379
FORWARD_MQTT_PORT=1883
FORWARD_MQTT_WS_PORT=9001
REVERB_SERVER_PORT=8080
VITE_PORT=5173
